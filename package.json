{
  "name": "qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal QA and Test Automation portfolio",
  "scripts": {
    "build": "tsc --project tsconfig.site.json && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=4",
    "lint:fix": "eslint . --fix",
    "validate:html": "html-validate \"docs/**/*.html\"",
    "check": "npm run typecheck && npm run lint && npm run validate:html",
    "test:local": "playwright test -c playwright.local.config.ts",
    "test:localUi": "playwright test -c playwright.local.config.ts --ui",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "testChromium": "playwright test --project=chromium",
    "test_homepage": "playwright test homepage-functional",
    "test_smoke": "playwright test smoke.spec.ts",
    "test_debug": "playwright test --debug",
    "test_list_tests": "npx playwright test --list",
    "test_codegen": "playwright codegen"
  },
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "globals": "^17.14.0",
    "html-validate": "^10.0.0",
    "http-server": "^14.1.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  }
}
