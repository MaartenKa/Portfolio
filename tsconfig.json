{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",

    "strict": true,

    "rootDir": ".",
    "outDir": "./dist",

    "skipLibCheck": true,
    "noEmitOnError": true
  },

  "include": [
    "src/**/*.ts",
    "playwright/tests/**/*.ts",
    "playwright/pages/**/*.ts",
    "playwright/utils/**/*.ts",
    "playwright/fixtures/**/*.ts",
    "playwright.config.ts"
  ]
}
