{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",

    "strict": true,

    "rootDir": ".",
    "outDir": "./dist",

    "skipLibCheck": true,
    "noEmitOnError": true,

    "types": ["node", "@playwright/test"]
  },

  "include": ["src/**/*.ts", "playwright/tests/**/*.ts", "playwright.config.ts"]
}
